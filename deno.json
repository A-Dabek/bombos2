{
  "imports": {
    "@builder.io/qwik": "npm:@builder.io/qwik@1.19.2",
    "@builder.io/qwik-city": "npm:@builder.io/qwik-city@1.19.2",
    "@builder.io/qwik/optimizer": "npm:@builder.io/qwik@1.19.2",
    "@builder.io/qwik-city/vite": "npm:@builder.io/qwik-city@1.19.2/vite",
    "@tailwindcss/vite": "npm:@tailwindcss/vite",
    "vite": "npm:vite@7.3.1",
    "vite-tsconfig-paths": "npm:vite-tsconfig-paths",
    "tailwindcss": "npm:tailwindcss",
    "undici": "npm:undici@6.0.0",
    "@qwikest/icons": "npm:@qwikest/icons@0.0.13",
    "playwright": "npm:playwright@1.51.0",
    "@playwright/test": "npm:@playwright/test@1.51.0"
  },
  "tasks": {
    "dev": "deno run -A npm:vite --mode ssr",
    "build": "deno run -A npm:vite build",
    "build.preview": "deno run -A npm:vite build --ssr src/entry.preview.tsx",
    "build.types": "deno run -A npm:typescript@5.4.5/tsc --incremental --noEmit",
    "preview": "deno run -A npm:vite preview",
    "lint": "deno run -A npm:eslint@9.32.0 src/**/*.ts*",
    "fmt": "deno run -A npm:prettier@3.6.2 --write .",
    "fmt.check": "deno run -A npm:prettier@3.6.2 --check .",
    "e2e": "npx @playwright/test test"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "@builder.io/qwik"
  },
  "nodeModulesDir": "auto",
  "exclude": ["node_modules", "dist", "server"]
}
