# Copy this file to `.env` and fill in real values. `.env` is loaded by
# `src/entry.fastify.tsx` via `dotenv/config`.

# --- Google auth (see docs/adr-031-google-auth.md) ---

# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Type: "Web application". Authorized JavaScript origins must include your
# app's origin(s), e.g. http://localhost:4173 and https://your-domain.tld
GOOGLE_CLIENT_ID=

# HMAC secret used to sign our long-lived session cookie. Any random string,
# minimum 16 characters. Generate with e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# Comma-separated allowlist of Gmail addresses that may sign in.
ALLOWED_EMAILS=you@gmail.com,wife@gmail.com

# Set to `true` ONLY in local dev / tests to fully bypass the auth guard.
# NEVER set this in production.
# AUTH_DISABLED=false
